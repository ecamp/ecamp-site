---
import { getImage } from "astro:assets";

import GoogleAnalytics from "~/components/core/GoogleAnalytics.astro";
import defaultImageSrc from "~/assets/images/social.png";

import { SITE } from "~/config.mjs";
import ExtraMetaTags from "../atoms/ExtraMetaTags.astro";

const {
  title = SITE.name,
  description = "",
  image: imageSrc = defaultImageSrc,
  imageAlt = title,
  canonical,
  type = "website",
  publishedTime,
  noindex = false,
  nofollow = false
} = Astro.props;

const {
  locale
} = Astro.params
const language = locale?.toString() || 'en'

// Link previews expect an absolute URL to a jpg/png, ideally cropped to 1200x630.
// Smaller images are not enlarged, so keep the aspect ratio within the source width.
const imageWidth = Math.min(1200, imageSrc.width);
const imageHeight = Math.round(imageWidth * 630 / 1200);
const { src: imagePath } = await getImage({
  src: imageSrc,
  width: imageWidth,
  height: imageHeight,
  fit: "cover",
  format: "jpg",
});
const image = new URL(imagePath, Astro.site).href;
const url = canonical ?? Astro.url.href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="shortcut icon" href="/favicon.ico" />

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}

<meta name="robots" content={`${noindex ? "noindex" : "index"}, ${nofollow ? "nofollow" : "follow"}`} />

<!-- Google / Search Engine Tags -->
<meta itemprop="name" content={title} />
<meta itemprop="description" content={description} />
<meta itemprop="image" content={image} />
<meta http-equiv="content-language" content={language} />

<!-- Open Graph Meta Tags -->
<meta property="og:url" content={url} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={`${language}_CH`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<!-- Twitter Meta Tags -->
<meta name="twitter:url" content={url} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Google Site Verification -->
{SITE.googleSiteVerificationId && <meta name="google-site-verification" content={SITE.googleSiteVerificationId} />}

<!-- Google Analytics -->
{SITE.googleAnalyticsId && <GoogleAnalytics id={SITE.googleAnalyticsId} partytown={true} />}

<ExtraMetaTags />
